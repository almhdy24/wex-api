# =====================================================================
# Wex Technology API Environment Configuration (.env.example)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================================

# Environment mode: 'development', 'testing', or 'production'
# In production, debug output and stack traces are suppressed.
CI_ENVIRONMENT=development

# Base URL of the API server (must include trailing slash)
app.baseURL=http://localhost:8081/

# Base URL of the frontend web / app client (used in emails and links)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Local development default: SQLite
database.default.DBDriver=SQLite3
database.default.database=wex.sqlite

# Production example (MySQL 8 / MariaDB 10.6+):
# database.default.DBDriver=MySQLi
# database.default.hostname=localhost
# database.default.database=wex_production
# database.default.username=wex_user
# database.default.password=YourStrongPasswordHere
# database.default.port=3306
# database.default.charset=utf8mb4
# database.default.DBCollat=utf8mb4_unicode_ci

# ---------------------------------------------------------------------
# Security and Encryption
# ---------------------------------------------------------------------
# CodeIgniter Encryption Key: 32 hex bytes prefixed with hex2bin:
encryption.key=

# JWT Secret: at least 32 cryptographically secure random bytes
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30
JWT_REFRESH_MAX_LIFETIME_DAYS=180

# Cookie Configuration (Same-site deployment recommended for mobile browsers)
# Serve web app and API under same site (e.g. wex.example and api.wex.example) -> Lax
# If cross-site deployment is strictly necessary, use None + COOKIE_SECURE=true over HTTPS.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# Google OAuth Client IDs (comma separated for web, Android, iOS)
GOOGLE_CLIENT_IDS=

# CORS Allowed Origins (comma separated, no trailing slash, no wildcards in prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------
# Mail Configuration
# ---------------------------------------------------------------------
# MAIL_DRIVER: 'log' for local testing (writes to writable/logs/emails/), or 'smtp' for production
MAIL_DRIVER=log
MAIL_FROM_EMAIL=noreply@wextechnology.com
MAIL_FROM_NAME="Wex Technology"

# SMTP Settings (used when MAIL_DRIVER=smtp)
email.SMTPHost=smtp.example.com
email.SMTPUser=user@example.com
email.SMTPPass=secret
email.SMTPPort=587
email.SMTPCrypto=tls

# Notification recipient for shop staff/owner when new payment proof is uploaded
SHOP_NOTIFY_EMAIL=shop@wextechnology.com

# ---------------------------------------------------------------------
# Initial Admin Setup
# ---------------------------------------------------------------------
# Initial admin email address for AdminSeeder and CLI commands
ADMIN_EMAIL=admin@wextechnology.com

# ---------------------------------------------------------------------
# Upload Settings
# ---------------------------------------------------------------------
# Maximum file upload size in megabytes
UPLOAD_MAX_MB=5
