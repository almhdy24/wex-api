# Public product images only. Allow-list: image types are served; everything else
# (scripts, HTML, SVG, archives…) is denied, and PHP can never execute here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(?i:jpe?g|png|webp|gif|avif)$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch "\.(?i:jpe?g|png|webp|gif|avif)$">
        Order deny,allow
        Allow from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
    Header set Cache-Control "public, max-age=2592000"
</IfModule>
