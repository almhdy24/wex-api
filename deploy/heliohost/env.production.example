# =====================================================================
# Wex — production .env (copy to <web root>/_wex_core/.env and fill in)
# NEVER commit this file with real values.
# You fill by hand: app.baseURL/APP_URL, database.*, MAIL/SMTP, GOOGLE_CLIENT_IDS,
# INSTALL_TOKEN. Leave encryption.key, JWT_SECRET, CRON_TOKEN and the VAPID keys
# EMPTY: the installer (https://<domain>/api/install > "توليد المفاتيح الناقصة")
# generates them and writes them into this file. Existing values are never changed.
# =====================================================================
CI_ENVIRONMENT = production

# Same-origin deployment: the site and the API share this origin.
app.baseURL = 'https://wex-technology.com/'
APP_URL = 'https://wex-technology.com'

# MariaDB from Plesk > Databases (recommended). Never use SQLite in production.
database.default.DBDriver = MySQLi
database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Generated by the installer (64 hex chars each). Changing JWT_SECRET signs everyone out;
# changing encryption.key makes encrypted values unreadable — keep a copy offline.
encryption.key =
JWT_SECRET =
JWT_ACCESS_TTL_MINUTES = 15
JWT_REFRESH_TTL_DAYS = 30

# Same-origin: no cross-origin browser access. For split hosting (API on another
# origin) list the web origin here and use COOKIE_SAMESITE=None.
CORS_ALLOWED_ORIGINS =
COOKIE_SECURE = true
COOKIE_SAMESITE = Lax

# Google sign-in: the Web client ID(s) from Google Cloud Console, comma-separated.
# Leave empty to offer email-code sign-in only.
GOOGLE_CLIENT_IDS =

# REQUIRED: sign-in is by email code, so without working mail nobody (not even the admin)
# can sign in. MAIL_DRIVER = smtp sends mail; = log writes it to writable/logs/emails/
# (use that briefly to read your own code if mail is not set up yet, then switch back).
MAIL_DRIVER = smtp

# How mail leaves the server. HelioHost/Plesk usually BLOCK outbound SMTP ports
# (connection refused on 587/465), so the local mail server is the reliable path:
#   MAIL_PROTOCOL = sendmail   -> local MTA (recommended on HelioHost); set the path below
#   MAIL_PROTOCOL = smtp       -> the email.SMTP* settings below (needs an open SMTP port)
#   MAIL_PROTOCOL = mail       -> PHP mail()
MAIL_PROTOCOL = sendmail
MAIL_SENDMAIL_PATH = /usr/sbin/sendmail
MAIL_FROM_EMAIL = noreply@wex-technology.com
MAIL_FROM_NAME = "Wex Technology"
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls

# Web push. VAPID keys are generated by the installer; VAPID_SUBJECT is a contact address.
PUSH_PROVIDER = webpush
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = 'mailto:support@wex-technology.com'

# Receipt / product photo limits (keep <= PHP upload_max_filesize on the host).
UPLOAD_MAX_MB = 5
UPLOAD_MAX_PIXELS = 40000000

# Periodic jobs (price-lock expiry, push/email queue, reminders, daily integrity check),
# EVERY 5 MINUTES (every minute risks HelioHost suspension). Pick one:
#  A. Plesk Scheduled Task "Run a PHP script": _wex_core/spark  arguments: cron:run
#  B. Plesk Scheduled Task "Fetch a URL" (cannot send headers): set
#     CRON_ALLOW_QUERY_TOKEN = true and fetch
#       https://wex-technology.com/api/v1/internal/cron?token=<CRON_TOKEN>
#  C. External pinger: POST https://wex-technology.com/api/v1/internal/cron
#     with header  X-Cron-Token: <CRON_TOKEN>
# CRON_TOKEN also guards POST /api/v1/internal/upgrade (migrations after an upgrade).
# Orders also expire lazily when read, so a missed run never shows a stale lock.
CRON_TOKEN =
CRON_ALLOW_QUERY_TOKEN = false
CRON_TIME_BUDGET_SECONDS = 20

# First-time setup without SSH: set a random value of 32+ chars (64 recommended), open
# https://<domain>/api/install, enter it, run the install, then DELETE this line
# (the page is 404 without it and 410 after install.lock exists).
INSTALL_TOKEN =

# Testing-only features (testing login, fake push log) are compiled out when
# CI_ENVIRONMENT = production, whatever is set here.
